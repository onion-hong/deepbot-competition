# Explicit code-only root. Historical evidence remains on disk.
/*
!/.gitignore
!/.gitattributes
!/competition/
**/__pycache__/
**/*.py[cod]
**/.venv/
**/.env
**/.env.*
**/*local.json
**/outputs/
**/data/
**/models/
**/*.bag
**/*.mp4
**/*.avi
**/*.pt
**/*.pth
**/*.onnx
**/*.bin
**/*.zip
**/*.rar
**/*.iso
**/*.exe
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*
**/authorized_keys
**/known_hosts

# Offline module outputs: retain local evidence, never stage generated datasets.
/competition/data_tools/outputs/
/competition/tests/data_tools/outputs/
/competition/data_tools/evidence/
/competition/perception/evidence/
/competition/mission/artifacts/
# Historical machine-local provenance remains unchanged beside its module.
/competition/mission/PROVENANCE.json
