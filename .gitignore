# Explicit code-only root. Historical evidence remains on disk.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/competition/
!/vehicle_ws/
**/__pycache__/
**/*.py[cod]
**/.venv/
**/.env
**/.env.*
**/*local.json
**/outputs/
**/data/
**/models/
**/*.bag
**/*.mp4
**/*.avi
**/*.pt
**/*.pth
**/*.onnx
**/*.bin
**/*.zip
**/*.rar
**/*.iso
**/*.exe
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*
**/authorized_keys
**/known_hosts

# Offline module outputs: retain local evidence, never stage generated datasets.
/competition/data_tools/outputs/
/competition/tests/data_tools/outputs/
/competition/data_tools/evidence/
/competition/perception/evidence/
/competition/mission/artifacts/
# Historical machine-local provenance remains unchanged beside its module.
/competition/mission/PROVENANCE.json

# Reconstructed catkin workspace: source only.
/vehicle_ws/build/
/vehicle_ws/devel/
/vehicle_ws/install/
/vehicle_ws/logs/
/vehicle_ws/.catkin_tools/
/vehicle_ws/outputs/

# These two historical YOLO directories contain code/config, not bundled weights.
!/vehicle_ws/legacy_packages/rikibot_yolov5/yolov5/models/
/vehicle_ws/legacy_packages/rikibot_yolov5/yolov5/models/**
!/vehicle_ws/legacy_packages/rikibot_yolov5/yolov5/models/**/
!/vehicle_ws/legacy_packages/rikibot_yolov5/yolov5/models/**/*.py
!/vehicle_ws/legacy_packages/rikibot_yolov5/yolov5/models/**/*.yaml
!/vehicle_ws/legacy_packages/rikibot_yolov5/yolov5/data/
/vehicle_ws/legacy_packages/rikibot_yolov5/yolov5/data/**
!/vehicle_ws/legacy_packages/rikibot_yolov5/yolov5/data/**/
!/vehicle_ws/legacy_packages/rikibot_yolov5/yolov5/data/**/*.yaml
!/vehicle_ws/legacy_packages/rikibot_yolov5/yolov5/data/**/*.sh
