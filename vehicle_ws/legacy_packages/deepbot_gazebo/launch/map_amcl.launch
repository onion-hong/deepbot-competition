<launch>
    <!-- 设置地图的配置文件 -->
    <arg name="map" default="house.yaml" />
    <!-- 运行地图服务器，并且加载设置的地图-->
    <node name="map_server" pkg="map_server" type="map_server" args="$(find deepbot_gazebo)/maps/$(arg map)"/>
    <!-- 启动AMCL节点 -->
    <include file="$(find deepbot_gazebo)/launch/amcl.launch" />
    <!-- 运行rviz -->
    <node pkg="rviz" type="rviz" name="rviz" output="screen" />
</launch>
