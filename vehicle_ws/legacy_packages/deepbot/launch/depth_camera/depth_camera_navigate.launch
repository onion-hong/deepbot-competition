<launch>
  <include file="$(find xtrobot)/launch/depth_camera/depth_camera_laser.launch"/>

  <arg name="map_file" default="$(find xtrobot)/maps/house.yaml"/>

  <node pkg="map_server" name="map_server"  type="map_server" args="$(arg map_file)" />


  <include file="$(find xtrobot)/launch/move_base.launch" />
  <!-- AMCL -->
  <include file="$(find xtrobot)/launch/amcl.launch"/>
  <node name="multi_mark" pkg="xtrobot" type="show_mark.py" output="screen" />


</launch>
