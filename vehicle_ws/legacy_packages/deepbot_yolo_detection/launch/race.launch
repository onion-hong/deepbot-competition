<?xml version="1.0"?>

<launch>
  <arg name="camera_type" value="$(env CAMERA)"/>
  <arg if="$(eval arg('camera_type') == 'astra')" name="input_image"        default="/camera/rgb/image_raw"/>
  <arg if="$(eval arg('camera_type') == 'astrapro')" name="input_image"        default="/camera/rgb/image_raw"/>
  <arg if="$(eval arg('camera_type') == 'usb')" name="input_image"        default="/camera/rgb/image_raw"/>
  <arg if="$(eval arg('camera_type') == 'csi')" name="input_image"        default="/camera/rgb/image_raw"/>
  <arg if="$(eval arg('camera_type') == 'intel')" name="input_image"      default="/camera/color/image_raw"/>
    <node if="true" pkg="deepbot_yolo_detection" type="deepbot_yolo_detection_node" name="deepbot_yolo_detection_node" clear_params="true" required="true">
        <remap from="/image_color" to="$(arg input_image)"/>
            
        <param name="yolo_names_file" value="$(find deepbot_yolo_detection)/conf/race.names"/>
        <param name="yolo_config_file" value="$(find deepbot_yolo_detection)/conf/yolov4-tiny-race.cfg"/>
        <param name="yolo_weights_file" value="$(find deepbot_yolo_detection)/conf/yolov4-tiny-race.weights"/>
    </node>
      
</launch>
